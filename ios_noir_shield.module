#!name=🛡️ iOS-NOIR Shield · 完整版
#!desc=65 条精准拦截，覆盖真机全部追踪域名；已排除微信与扫码支付链路
#!system=ios

[Rule]
# ══════════════════════════════════════════════════════════════════════
DOMAIN-SUFFIX,tenpay.com,DIRECT
DOMAIN-SUFFIX,weixin.qq.com,DIRECT
DOMAIN-SUFFIX,wx.qq.com,DIRECT
DOMAIN-SUFFIX,wechat.com,DIRECT
DOMAIN-SUFFIX,servicewechat.com,DIRECT
DOMAIN-SUFFIX,qlogo.cn,DIRECT
DOMAIN-SUFFIX,qpic.cn,DIRECT
DOMAIN-SUFFIX,gtimg.cn,DIRECT
DOMAIN-SUFFIX,alipay.com,DIRECT
DOMAIN-SUFFIX,alipayobjects.com,DIRECT
DOMAIN-SUFFIX,alipay.cn,DIRECT
DOMAIN-SUFFIX,unionpay.com,DIRECT
DOMAIN-SUFFIX,unionpayintl.com,DIRECT
DOMAIN-SUFFIX,95516.com,DIRECT
# 中国移动 CM Passport 统一认证
DOMAIN-SUFFIX,cmpassport.com,REJECT
# 运营商系取号网关（中移互联网）
DOMAIN-SUFFIX,id6.me,REJECT
# 中国联通 沃商店 / 短信 / MDN(本机号码) 网关
DOMAIN-SUFFIX,wostore.cn,REJECT
DOMAIN-SUFFIX,wosms.cn,REJECT
DOMAIN-SUFFIX,mdn.open.wo.cn,REJECT
DOMAIN-SUFFIX,hm.wo.cn,REJECT
# 中国电信 取号网关（只拦认证子域，不动 189.cn 主站/营业厅）
DOMAIN-SUFFIX,open.e.189.cn,REJECT
DOMAIN-SUFFIX,id.189.cn,REJECT
# 数字联盟 —— 跨 App 设备 DNA 指纹（改机/重装/换机都跟着你）
DOMAIN-SUFFIX,shuzilm.cn,REJECT-DROP
# JSPatch —— 远程下发 JS 改原生逻辑的热更新后门
DOMAIN-SUFFIX,jspatch.com,REJECT
# ThreatMetrix / LexisNexis —— 键盘节奏、按压力度行为生物特征
DOMAIN-SUFFIX,online-metrix.net,REJECT-DROP
DOMAIN-SUFFIX,online-metrix.com,REJECT-DROP
# D1. 秒针系统 Miaozhen（跨端广告归因，国内覆盖率最高之一）
DOMAIN-SUFFIX,miaozhen.com,REJECT-TINYGIF
DOMAIN-SUFFIX,mmstat.com,REJECT-TINYGIF
# D2. 友盟 Umeng（阿里系统计/推送 SDK）
DOMAIN-SUFFIX,umeng.com,REJECT-TINYGIF
DOMAIN-SUFFIX,umengcloud.com,REJECT-TINYGIF
DOMAIN-SUFFIX,umsns.com,REJECT-TINYGIF
# D3. 穿山甲 / 巨量引擎（只拦 SDK 专属域，绝不动 *.snssdk.com 主干）
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT-TINYGIF
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT-TINYGIF
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT-TINYGIF
